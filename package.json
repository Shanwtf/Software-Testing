{
  "name": "geeksforgeeks-playwright-testing",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright-based test automation suite for GeeksforGeeks website",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --config=playwright.headed.config.js --workers=1 --retries=0",
    "test:file": "playwright test tests/homepage.spec.js",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
